# Agua ZMG: variables de entorno.
#
# Desarrollo local: copia este archivo a web/.env.local (lo leen `pnpm migrate`,
# `pnpm import:colonias` y `pnpm dev`). NUNCA subas .env.local ni .env.prod al repositorio.
# Producción: define las mismas variables en el panel de tu hosting (o en .env.prod para
# docker-compose.prod.yml). Guía completa: docs/DEPLOY.md.
#
# Marcadas [OBLIGATORIA PROD] = la app se niega a arrancar o a funcionar bien sin ellas en producción.

# ---------------------------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------------------------
# PostgreSQL con PostGIS. Local: docker compose up -d (puerto 5433).
# En Neon usa la cadena con "-pooler" en el host (PgBouncer) y ?sslmode=require. [OBLIGATORIA PROD]
DATABASE_URL=postgres://agua:agua@localhost:5433/agua_zmg

# ---------------------------------------------------------------------------------------------
# Anti-abuso y privacidad
# ---------------------------------------------------------------------------------------------
# Secreto del que se derivan los HMAC anónimos (huella, red). Mínimo 32 caracteres aleatorios.
# Genera uno con:  openssl rand -hex 32
# Déjalo VACÍO aquí y genera el tuyo: docker compose y la app se niegan a arrancar sin uno propio.
# Sin él (o con uno corto o conocido, p. ej. el de un ejemplo) la app se niega a procesar reportes en producción. [OBLIGATORIA PROD]
# Rotar al menos cada trimestre. Vive FUERA de la base de datos. No lo compartas ni lo subas al repo.
HASH_SALT=

# Cuántos proxies de confianza hay delante de la app; la IP del visitante se lee contando DESDE LA
# DERECHA de X-Forwarded-For. Vercel: 1. Caddy/nginx propio solo: 1. Detrás de otro proxy
# (p. ej. Cloudflare + Caddy) puede ser 2: PRUÉBALO (docs/DEPLOY.md, "IP real del visitante").
TRUSTED_PROXY_HOPS=1

# Dominios extra desde los que se acepta el formulario (lista separada por comas, sin https://).
# El host de la propia petición ya se acepta. Ej.: agua.ejemplo.org,www.agua.ejemplo.org
ORIGENES_PERMITIDOS=

# Volumen global de reportes por hora a partir del cual todos entran a revisión (nunca rechaza).
# LIMITE_GLOBAL_HORA=3000

# Interruptor de emergencia: "1" manda TODOS los reportes nuevos a revisión (no cuentan en el mapa
# hasta que un moderador los restaure). Úsalo si hay un ataque en curso (docs/OPERACION.md).
# MODO_ATAQUE=0

# SOLO DESARROLLO: "1" relaja los límites de tasa para pruebas locales. Se ignora en producción.
# ANTIABUSO_RELAJADO=1

# ---------------------------------------------------------------------------------------------
# Panel de moderación (/admin)
# ---------------------------------------------------------------------------------------------
# Token de acceso, mínimo 16 caracteres. Sin él (o más corto) /admin queda DESHABILITADO.
# Genera uno con:  openssl rand -hex 32     Rotarlo invalida todas las sesiones abiertas.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------------------------
# Sitio y mapa (variables NEXT_PUBLIC_*: se incrustan en el build; en Docker son build args)
# ---------------------------------------------------------------------------------------------
# URL pública del sitio, sin "/" final (enlaces absolutos de Open Graph). Ej.: https://agua.ejemplo.org
# En Vercel, si no se define, se usa VERCEL_PROJECT_PRODUCTION_URL.
# OBLIGATORIA en producción: si falta, las vistas previas al compartir (WhatsApp, redes) apuntan a localhost.
# NEXT_PUBLIC_SITE_URL=https://agua.ejemplo.org

# Estilo del mapa base (MapLibre). Por defecto OpenFreeMap "positron" (sin llaves, sin cuota publicada,
# SIN SLA; ver docs/research/despliegue.md §3). Para cambiar de proveedor, apunta a otro style.json.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Orígenes que la política de seguridad (CSP, en proxy.ts) deja cargar teselas, estilos y glifos del
# mapa, separados por espacios. Si cambias NEXT_PUBLIC_MAP_STYLE_URL a otro proveedor, AGRÉGALO aquí
# o el navegador bloqueará el mapa. Por defecto: OpenStreetMap y OpenFreeMap.
# CSP_MAPA_ORIGENES=https://tiles.openfreemap.org

# Quién puede incrustar /embed/* en un iframe (por defecto cualquiera: medios, colectivos).
# CSP_EMBED_ANCESTORS=*

# ---------------------------------------------------------------------------------------------
# API pública /api/v1 y versión
# ---------------------------------------------------------------------------------------------
# Licencia declarada de los datos de la API. Por defecto ODbL-1.0 y se marca "provisional" hasta que
# quien responde por el proyecto la confirme. Al definir el nombre pasa a "confirmada" y la página /datos
# deja de mostrar el aviso. Se lee al CONSTRUIR (también en Docker: son build args).
# DATOS_LICENCIA_NOMBRE=ODbL-1.0
# DATOS_LICENCIA_URL=https://opendatacommons.org/licenses/odbl/1-0/

# ---------------------------------------------------------------------------------------------
# Datos del sitio que solo puede aportar quien responde por el proyecto (se leen al CONSTRUIR)
# ---------------------------------------------------------------------------------------------
# Mientras falten, las páginas lo dicen con honestidad («aún por definir») en vez de inventar nada.
# Correo público de contacto, moderación y apelación (Acerca de, Metodología, Privacidad).
# CONTACTO_EMAIL=correo@ejemplo.org
# Quién responde por el tratamiento de datos personales (aviso de privacidad). Las tres con valor
# (junto con CONTACTO_EMAIL) sustituyen el «aún por definir».
# RESPONSABLE_NOMBRE=
# RESPONSABLE_DOMICILIO=
# "1" SOLO cuando un abogado haya revisado el aviso de privacidad (quita el aviso de borrador).
# AVISO_PRIVACIDAD_REVISADO=0
# "1" SOLO cuando una persona de salud (médico/a, epidemiólogo/a, enfermero/a) haya revisado /que-hacer.
# GUIA_REVISADA_SALUD=0

# Versión que reporta /api/salud (p. ej. el SHA corto del commit). En Vercel se usa
# VERCEL_GIT_COMMIT_SHA automáticamente.
# APP_VERSION=

# ---------------------------------------------------------------------------------------------
# Solo docker-compose.prod.yml (se leen de .env.prod, no de la app)
# ---------------------------------------------------------------------------------------------
# POSTGRES_PASSWORD=          # openssl rand -hex 24  (solo hex: va dentro de una URL)
# DOMINIO=agua.ejemplo.org    # solo con el perfil "caddy" (HTTPS automático)
# WEB_PORT=3000               # puerto local (127.0.0.1) de la app
