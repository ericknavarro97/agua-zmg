{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:colonias": "tsx --env-file=.env.local scripts/import-colonias.ts",
    "copy:maplibre": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "predev": "pnpm copy:maplibre",
    "prebuild": "pnpm copy:maplibre",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "import:oficial": "tsx --env-file-if-exists=.env.local scripts/import-oficial.ts",
    "purge": "tsx --env-file-if-exists=.env.local scripts/purge.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e:setup": "bash e2e/setup.sh",
    "e2e": "bash e2e/run.sh"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shapefile": "^0.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.32.1"
}
